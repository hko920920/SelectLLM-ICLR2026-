{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://selectllm.invalid/schemas/praa-admission-manifest-v1.json",
  "title": "PRAA candidate endpoint admission manifest",
  "description": "Machine-readable identity, lineage, execution, and label-space evidence for one submitted candidate endpoint. The schema authenticates declared units; it does not infer common ownership from response similarity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entry_id",
    "provider_id",
    "declared_root_id",
    "artifact",
    "lineage",
    "runtime",
    "input_schema",
    "output_schema",
    "label_mapping",
    "attestation"
  ],
  "properties": {
    "schema": {
      "const": "praa.admission_manifest.v1"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
    },
    "declared_root_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "revision", "files"],
      "properties": {
        "source_type": {
          "enum": ["huggingface_model", "pypi_package", "oci_image", "local_signed_artifact"]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_family", "root_relation", "upstream_artifacts"],
      "properties": {
        "implementation_family": {"type": "string", "minLength": 1},
        "root_relation": {
          "enum": ["canonical_root_endpoint", "derived_endpoint", "independent_root"]
        },
        "upstream_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "source_id", "revision_or_sha256"],
            "properties": {
              "relation": {
                "enum": ["base_model", "fine_tuned_from", "adapter_on", "wrapper_of", "distilled_from", "package_contains"]
              },
              "source_id": {"type": "string", "minLength": 1},
              "revision_or_sha256": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "dependencies", "entrypoint", "deterministic_settings"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "container_digest": {
          "type": ["string", "null"],
          "pattern": "^(sha256:[0-9a-f]{64})$"
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "artifact_sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "entrypoint": {"type": "string", "minLength": 1},
        "deterministic_settings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "fields", "preprocessing_sha256"],
      "properties": {
        "media_type": {"const": "application/json"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["string", "integer", "number", "boolean"]}
            }
          }
        },
        "preprocessing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_label_field", "confidence_field", "private_abstention_codes"],
      "properties": {
        "hard_label_field": {"type": "string", "minLength": 1},
        "confidence_field": {"type": ["string", "null"]},
        "private_abstention_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": ["string", "integer"]}
        }
      }
    },
    "label_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_labels", "native_to_target", "out_of_target_policy"],
      "properties": {
        "target_labels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "native_to_target": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "integer"]
          }
        },
        "out_of_target_policy": {
          "const": "map_to_private_always_incorrect_code"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "signer_id", "signature_algorithm", "signature"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signer_id": {"type": "string", "minLength": 1},
        "signature_algorithm": {"enum": ["ed25519", "ecdsa-p256-sha256", "development-null-signature"]},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  }
}
